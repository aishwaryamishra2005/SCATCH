<%- include('./partials/header') %>

<body class="bg-zinc-950 text-white">

    <%
        let cartItems = user.cart.filter(Boolean);
        let subtotal = cartItems.reduce(function(total, product) {
            return total + Number(product.price || 0);
        }, 0);
    %>



    <!-- MAIN CONTENT -->
    <main class="max-w-7xl mx-auto px-6 md:px-10 py-14">

        <!-- PAGE HEADING -->
        <div class="mb-12">

            <p class="text-blue-400 text-xs uppercase tracking-[0.35em] mb-3">
                Your Shopping Bag
            </p>

            <div class="flex flex-wrap items-end justify-between gap-4">

                <div>
                    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">
                        My Cart<span class="text-blue-500"></span>
                    </h1>

                    <p class="text-zinc-500 mt-3">
                        Review your selected products before checkout.
                    </p>
                </div>

                <p class="text-sm text-zinc-400">
                    <span class="text-white font-semibold"><%= cartItems.length %></span>
                    Items in your cart
                </p>

            </div>
        </div>


        <% if (cartItems.length === 0) { %>

            <!-- EMPTY CART -->
            <div class="min-h-[420px] flex flex-col items-center justify-center text-center bg-zinc-900 border border-zinc-800 rounded-2xl px-6">

                <div class="w-24 h-24 rounded-full bg-blue-950/50 flex items-center justify-center mb-7">
                    <i class="ri-shopping-bag-3-line text-5xl text-blue-400"></i>
                </div>

                <h2 class="text-2xl font-semibold mb-3">
                    Your cart is empty
                </h2>

                <p class="text-zinc-500 max-w-md mb-8">
                    Looks like you haven't added anything to your cart yet.
                    Explore our collection and find something you love.
                </p>

                <a href="/shop"
                    class="px-8 py-3 bg-blue-800 hover:bg-blue-700 rounded-lg text-sm font-medium transition">
                    Explore Collection
                    <i class="ri-arrow-right-line ml-2"></i>
                </a>

            </div>

        <% } else { %>


            <!-- CART + ORDER SUMMARY -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">


                <!-- CART ITEMS -->
                <section class="lg:col-span-2">

                    <div class="flex items-center justify-between border-b border-zinc-800 pb-5 mb-7">

                        <h2 class="text-lg font-semibold">
                            Shopping Cart
                        </h2>

                        <span class="text-xs uppercase tracking-widest text-zinc-500">
                            Product Details
                        </span>

                    </div>


                    <div class="flex flex-col gap-6">

                        <% cartItems.forEach(function(product) { %>

                            <!-- PRODUCT CARD -->
                            <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 flex flex-col sm:flex-row gap-6 hover:border-blue-900 transition">

                                <!-- IMAGE -->
                                <div class="w-full sm:w-40 h-40 bg-white rounded-lg flex items-center justify-center p-4 shrink-0">

                                    <img
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                        alt="<%= product.name %>"
                                        class="w-full h-full object-contain">

                                </div>


                                <!-- DETAILS -->
                                <div class="flex-1 flex flex-col justify-between">

                                    <div>

                                        <div class="flex items-start justify-between gap-4">

                                            <div>
                                                <p class="text-xs uppercase tracking-widest text-blue-400 mb-2">
                                                    SCATCH Collection
                                                </p>

                                                <h3 class="text-xl font-semibold">
                                                    <%= product.name %>
                                                </h3>
                                            </div>

                                            <% if (product.discount > 0) { %>
                                                <span class="bg-blue-950 text-blue-300 text-xs px-3 py-1 rounded-full whitespace-nowrap">
                                                    <%= product.discount %>% OFF
                                                </span>
                                            <% } %>

                                        </div>

                                    </div>


                                    <div class="flex items-end justify-between mt-8">

                                        <div>
                                            <p class="text-xs text-zinc-500 mb-1">
                                                Price
                                            </p>

                                            <p class="text-xl font-bold text-white">
                                                ₹ <%= product.price %>
                                            </p>
                                        </div>

                                        <p class="text-xs text-zinc-500">
                                            <i class="ri-checkbox-circle-line text-blue-400 mr-1"></i>
                                            Added to cart
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>


                    <!-- CONTINUE SHOPPING -->
                    <a href="/shop"
                        class="inline-flex items-center gap-2 text-sm text-blue-400 hover:text-blue-300 mt-9 transition">

                        <i class="ri-arrow-left-line"></i>
                        Continue Shopping

                    </a>

                </section>



                <!-- ORDER SUMMARY -->
                <aside class="lg:col-span-1">

                    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-7 sticky top-28">

                        <h2 class="text-xl font-semibold mb-7">
                            Order Summary
                        </h2>


                        <div class="space-y-5 border-b border-zinc-800 pb-7">

                            <div class="flex justify-between text-sm">
                                <span class="text-zinc-400">Total Items</span>
                                <span class="text-white"><%= cartItems.length %></span>
                            </div>

                            <div class="flex justify-between text-sm">
                                <span class="text-zinc-400">Subtotal</span>
                                <span class="text-white">₹ <%= subtotal.toFixed(2) %></span>
                            </div>

                            <div class="flex justify-between text-sm">
                                <span class="text-zinc-400">Shipping</span>
                                <span class="text-zinc-500">Calculated at checkout</span>
                            </div>

                        </div>


                        <div class="flex justify-between items-center py-7">

                            <span class="font-semibold">
                                Total
                            </span>

                            <span class="text-2xl font-bold text-blue-400">
                                ₹ <%= subtotal.toFixed(2) %>
                            </span>

                        </div>


                        <button disabled
                            class="w-full py-4 bg-blue-900/50 text-blue-200/60 rounded-lg font-medium cursor-not-allowed">
                            Checkout Coming Soon
                            <i class="ri-arrow-right-line ml-2"></i>
                        </button>


                        <div class="mt-7 flex items-center gap-3 text-zinc-500 text-xs">
                            <i class="ri-shield-check-line text-xl text-blue-400"></i>
                            Secure shopping experience
                        </div>

                    </div>

                </aside>

            </div>

        <% } %>

    </main>

</body>
</html>

    <%- include('./partials/footer') %>