<link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>

                <body class="bg-zinc-950 min-h-screen">


                    <div class="min-h-screen bg-zinc-950">

                        <!-- NAVBAR -->


                        <header class="h-20 bg-zinc-900 border-b border-zinc-800
               px-10 flex items-center sticky top-0 z-50">

                            <a href="/shop" class="text-2xl font-semibold tracking-[0.2em] text-white">
                                <span class="text-blue-500">SCATCH</span>
                            </a>

                            <div class="ml-auto flex items-center gap-10">

                                <nav class="flex items-center gap-10 text-sm text-zinc-400">
                                    <a href="/shop" class="hover:text-white transition">Home</a>
                                    <a href="/shop/cart" class="hover:text-white transition">Cart</a>
                                    <a href="/owners/admin" class="hover:text-white transition">Create</a>

                                </nav>

                                <a href="/user/logout" class="px-5 py-2 bg-blue-800 hover:bg-blue-700
                  text-white text-sm rounded-lg transition">
                                    Logout
                                </a>

                            </div>
                        </header>

<% if (success.length> 0) { %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500">

        <span class="inline-block mt-1 mb-1 text-white">
            <%= success[0] %>
        </span>


    </div>
    <% } %>
        <% if (error.length> 0) { %>
            <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500 z-50">
                <span class="text-white">
                    <%= error[0] %>
                </span>
            </div>
            <% } %>

                        <!-- SIDEBAR + MAIN CONTENT -->
                        <div class="flex bg-zinc-950 ">

                            <!-- SIDEBAR -->
                            <aside class="w-64 shrink-0 h-[calc(100vh-5rem)] sticky top-20
              self-start overflow-y-auto bg-zinc-900
              border-r border-zinc-800 p-7">

                                <!-- SORT BY -->





                                <!-- COLLECTIONS -->
                                <div class="mb-12">

                                    <h3 class="text-xs uppercase tracking-[0.2em]
                           text-blue-400 mb-5">
                                        Collections
                                    </h3>

                                    <div class="flex flex-col gap-5 text-sm">

                                        <a href="/shop" class="text-zinc-400 hover:text-white transition">
                                            All Products
                                        </a>

                                        <a href="#products" class="text-zinc-400 hover:text-white transition">
                                            New Collection
                                        </a>

                                        <a href="#products" class="text-zinc-400 hover:text-white transition">
                                            Discounted Products
                                        </a>

                                    </div>

                                </div>


                                <!-- FILTER BY -->
                                <div class="mb-12">

                                    <h3 class="text-xs uppercase tracking-[0.2em]
                           text-blue-400 mb-5">
                                        Filter By
                                    </h3>

                                    <div class="flex flex-col gap-5 text-sm text-zinc-300">

                                        <label class="flex items-center gap-3">
                                            <input type="checkbox" class="accent-blue-700">
                                            Availability
                                        </label>

                                        <label class="flex items-center gap-3">
                                            <input type="checkbox" class="accent-blue-700">
                                            Discount
                                        </label>

                                    </div>

                                </div>

                            </aside>


                            <!-- MAIN CONTENT -->
                            <main class="flex-1 min-w-0">


                                <!-- FULL HEIGHT HERO SECTION -->
                                <section class="relative min-h-[calc(100vh-5rem)] w-full
                            bg-zinc-950 flex items-center overflow-hidden
                            border-b border-zinc-800">



                                    <div class="relative z-10 px-16 md:px-24 max-w-4xl">

                                        <p class="text-blue-400 text-sm tracking-[0.4em]
                              uppercase mb-8">
                                            The New Collection
                                        </p>

                                        <h1 class="text-6xl md:text-8xl font-semibold
                               text-white leading-tight mb-8">
                                            Carry Your
                                            <span class="text-blue-500">Style.</span>
                                        </h1>

                                        <p class="text-zinc-400 text-lg leading-relaxed
                              max-w-xl mb-10">
                                            Discover thoughtfully designed bags that
                                            complement your everyday lifestyle.
                                            Style meets functionality with SCATCH.
                                        </p>

                                        <a href="#products" class="inline-block bg-blue-800 hover:bg-blue-700
                              text-white px-10 py-4 rounded-lg
                              tracking-wide transition duration-300">
                                            Explore Collection
                                        </a>

                                        <p class="text-zinc-600 text-xs tracking-widest
                              uppercase mt-16">
                                            Designed for everyday elegance
                                        </p>

                                    </div>

                                </section>


                                <!-- PRODUCTS SECTION -->
                                <section id="products" class="p-10">

                                    <!-- PRODUCT HEADING -->
                                    <div class="flex items-center justify-between mb-10">

                                        <div>

                                            <p class="text-blue-400 text-xs uppercase
                                  tracking-[0.25em] mb-2">
                                                Curated For You
                                            </p>

                                            <h2 class="text-3xl font-semibold text-white">
                                                Our Collection
                                            </h2>

                                        </div>

                                        <p class="text-sm text-zinc-500">
                                            <%= products.length %> Products
                                        </p>

                                    </div>


                                    <!-- PRODUCT GRID -->
                                    <div class="grid grid-cols-1 sm:grid-cols-2
                            lg:grid-cols-2 xl:grid-cols-3
                            2xl:grid-cols-4 gap-8">

                                        <% products.forEach(function(product){ %>

                                            <!-- PRODUCT CARD -->
                                            <div class="group bg-white border border-blue-900/70
                                    rounded-xl overflow-hidden
                                    shadow-lg shadow-black/20
                                    hover:-translate-y-2
                                    hover:shadow-xl hover:shadow-blue-950/30
                                    transition-all duration-300">


                                                <!-- PRODUCT IMAGE -->
                                                <div class="relative h-64 bg-zinc-100
                                        flex items-center justify-center
                                        p-6 overflow-hidden">

                                                    <img class="h-full w-full object-contain
                                           group-hover:scale-110
                                           transition-transform duration-500"
                                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                                        alt="Product Image">

                                                    <% if(product.discount> 0){ %>

                                                        <span class="absolute top-4 left-4
                                                 bg-blue-900 text-white
                                                 text-xs px-3 py-1 rounded-full">
                                                            <%= product.discount %>% OFF
                                                        </span>

                                                        <% } %>

                                                </div>


                                                <!-- PRODUCT DETAILS -->
                                                <div class="p-5">

                                                    <h3 class="text-lg font-semibold text-zinc-900">
                                                        <%= product.name %>
                                                    </h3>

                                                    <div class="flex items-center justify-between mt-4">

                                                        <div>

                                                            <p class="text-xl font-bold text-blue-900">
                                                                ₹ <%= product.price %>
                                                            </p>

                                                            <% if(product.discount> 0){ %>

                                                                <p class="text-xs text-green-700 mt-1">
                                                                    Special Discount
                                                                </p>

                                                                <% } %>

                                                        </div>


                                                        <!-- ADD TO CART BUTTON -->
                                                        <form action="/shop/addtocart/<%= product._id %>" method="POST">
                                                            <button type="submit" class="w-10 h-10 rounded-full
        bg-blue-900 text-white text-2xl
        flex items-center justify-center
        hover:bg-blue-700 transition">
                                                                +
                                                            </button>
                                                        </form>


                                                    </div>

                                                </div>

                                            </div>

                                            <% }) %>

                                    </div>

                                </section>

                            </main>

                        </div>

                    </div>
                </body>
                <%- include('./partials/footer') %>